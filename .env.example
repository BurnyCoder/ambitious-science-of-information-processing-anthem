# Copy to .env and fill in your key: cp .env.example .env
# sunoapi.org API key (https://sunoapi.org/api-key) — required, never commit .env
SUNO_API_KEY=
# sunoapi.org base URL (https://docs.sunoapi.org/ — "All API requests should be sent to")
SUNO_API_BASE_URL=https://api.sunoapi.org
# Suno model; V6 is the current default in https://docs.sunoapi.org/suno-api/generate-music
SUNO_MODEL=V6
# Target song length in seconds (custom mode, 10–360; API default is only 20)
SONG_DURATION_S=240
# Seconds between status polls and total timeout for one generation task
SUNO_POLL_INTERVAL_S=15
SUNO_TIMEOUT_S=900
# Required-by-schema callback URL; we poll instead, so any reachable placeholder works
SUNO_CALLBACK_URL=https://example.com/suno-callback
# Video frame rate used for timeline sampling and Remotion render
VIDEO_FPS=30
# Parallel Chrome tabs for the Remotion render (https://www.remotion.dev/docs/cli/render#--concurrency)
RENDER_CONCURRENCY=8
